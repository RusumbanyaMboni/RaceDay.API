@model RaceDay.MVC.Models.ParticipantProfileViewModel

@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-2">
                        Edit Profile
                    </h2>

                    <p class="text-muted mb-4">
                        Update your personal information.
                    </p>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <form asp-controller="ParticipantProfile"
                          asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- First Name -->
                        <div class="mb-3">

                            <label asp-for="FirstName"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   maxlength="100" />

                            <span asp-validation-for="FirstName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Last Name -->
                        <div class="mb-3">

                            <label asp-for="LastName"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   maxlength="100" />

                            <span asp-validation-for="LastName"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Email: Read-only -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                Email Address
                            </label>

                            <input type="email"
                                   value="@Model.Email"
                                   class="form-control"
                                   disabled />

                            <div class="form-text">
                                Your email address cannot be
                                changed from this page.
                            </div>

                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="form-control"
                                   maxlength="20"
                                   placeholder="e.g. 0821234567" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <!-- Date of Birth -->
                        <div class="mb-3">

                            <label asp-for="DateOfBirth"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control" />

                            <span asp-validation-for="DateOfBirth"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-info">
                            Changes to your first name, surname,
                            phone number and date of birth will
                            be saved to your RaceDay account.
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="ParticipantProfile"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
