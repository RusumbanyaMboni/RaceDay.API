
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.MVC.styles.css" asp-append-version="true" />
</head>
<body class="raceday-theme">

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark raceday-navbar shadow-sm mb-4">
            <div class="container">

                <a class="navbar-brand fw-bold raceday-brand"
                   asp-controller="Account"
                   asp-action="Login">
                    🏃 RaceDay
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#raceDayNavbar"
                        aria-controls="raceDayNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="raceDayNavbar">

                    <ul class="navbar-nav ms-auto align-items-sm-center">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var role = User.IsInRole("Organiser")
                                ? "Organiser"
                                : "Participant";

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="@(role == "Organiser" ? "Organiser" : "Participant")"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post"
                                      class="d-inline">
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-raceday-logout btn-sm ms-sm-3 mt-2 mt-sm-0">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Login
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Register
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container raceday-content">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="raceday-footer">
        <div class="container text-center">
            &copy; 2026 RaceDay |
            Your Race. Your Journey. Your Victory.
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
