@model List<RaceDay.MVC.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Category Management";

    int eventId = ViewBag.EventId != null
        ? Convert.ToInt32(ViewBag.EventId)
        : 0;
}

<div class="container mt-5 mb-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between
        align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Category Management
            </h2>

            <p class="text-muted mb-0">
                Manage the race categories for this event.
            </p>
        </div>

        <a asp-controller="CategoryManagement"
           asp-action="Create"
           asp-route-eventId="@eventId"
           class="btn btn-primary">
            + Add Category
        </a>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Category List -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been created for this event yet.
            Click <strong>Add Category</strong> to create one.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-striped
                table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Category Name</th>
                        <th>Minimum Age</th>
                        <th>Maximum Age</th>
                        <th>Distance</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td class="fw-semibold">
                                @category.CategoryName
                            </td>

                            <td>
                                @(category.MinimumAge?.ToString() ?? "No limit")
                            </td>

                            <td>
                                @(category.MaximumAge?.ToString() ?? "No limit")
                            </td>

                            <td>
                                @category.Distance.ToString("0.##") km
                            </td>

                            <td>
                                <div class="d-flex gap-2">

                                    <a asp-controller="CategoryManagement"
                                       asp-action="Edit"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <a asp-controller="CategoryManagement"
                                       asp-action="Delete"
                                       asp-route-id="@category.CategoryId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </div>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        <p class="text-muted mt-3">
            Total Categories:
            <strong>@Model.Count</strong>
        </p>
    }

    <!-- Navigation -->
    <div class="mt-4">

        <a asp-controller="EventManagement"
           asp-action="Details"
           asp-route-id="@eventId"
           class="btn btn-outline-secondary">
            Back to Event Details
        </a>

    </div>

</div>
