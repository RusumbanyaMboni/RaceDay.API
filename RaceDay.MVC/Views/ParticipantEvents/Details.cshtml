
@model RaceDay.MVC.Models.ParticipantEventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";

    bool hasEventImage = Model.Event.HasEventImage;
}

<div class="container mt-5 mb-5">

    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <!-- EVENT DETAILS -->
            <div class="card shadow border-0 mb-4">

                <div class="card-body p-4">

                    <!-- PAGE HEADER -->
                    <div class="d-flex justify-content-between
                                align-items-center flex-wrap gap-3 mb-4">

                        <div>
                            <h2 class="fw-bold mb-1">
                                Event Details
                            </h2>

                            <p class="text-muted mb-0">
                                Explore this event and its available categories.
                            </p>
                        </div>

                        <span class="badge bg-primary fs-6">
                            @Model.Event.EventType
                        </span>

                    </div>

                    <hr />

                    <!-- EVENT NAME -->
                    <h3 class="fw-bold mt-4">
                        @Model.Event.EventName
                    </h3>

                    <!-- ====================================== -->
                    <!-- AZURE BLOB STORAGE - EVENT IMAGE        -->
                    <!-- ====================================== -->

                    <div class="mt-4 mb-4">

                        @if (hasEventImage)
                        {
                            <!-- IMAGE RETRIEVED THROUGH MVC AND API -->
                            <img src="@Url.Action(
                                          "Image",
                                          "ParticipantEvents",
                                          new { id = Model.Event.EventId })"
                                 alt="Image for @Model.Event.EventName"
                                 class="img-fluid rounded shadow-sm w-100"
                                 style="max-height: 400px;
                                        object-fit: cover;" />

                        }
                        else
                        {
                            <!-- PLACEHOLDER FOR EVENTS WITHOUT IMAGES -->
                            <div class="bg-light rounded border
                                        d-flex flex-column
                                        align-items-center
                                        justify-content-center
                                        text-center"
                                 style="min-height: 250px;">

                                <div class="fs-1 mb-2">
                                    🏁
                                </div>

                                <h5 class="fw-bold mb-2">
                                    RaceDay Event
                                </h5>

                                <p class="text-muted mb-0">
                                    No event image available.
                                </p>

                            </div>
                        }

                    </div>

                    <!-- DESCRIPTION -->
                    <div class="mt-3">

                        <h5 class="fw-semibold">
                            Description
                        </h5>

                        <p class="text-muted">
                            @(string.IsNullOrWhiteSpace(Model.Event.Description)
                                ? "No description provided."
                                : Model.Event.Description)
                        </p>

                    </div>

                    <!-- EVENT INFORMATION -->
                    <div class="row g-3 mt-3">

                        <!-- EVENT DATE -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Event Date
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.Event.EventDate.ToString("dd MMM yyyy")
                                    </h5>

                                </div>
                            </div>

                        </div>

                        <!-- START TIME -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Start Time
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.Event.EventDate.ToString("HH:mm")
                                    </h5>

                                </div>
                            </div>

                        </div>

                        <!-- LOCATION -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Location
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.Event.Location
                                    </h5>

                                </div>
                            </div>

                        </div>

                        <!-- EVENT DISTANCE -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Event Distance
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.Event.Distance.ToString("0.##") km
                                    </h5>

                                </div>
                            </div>

                        </div>

                    </div>

                </div>
            </div>

            <!-- ====================================== -->
            <!-- AVAILABLE CATEGORIES AND REGISTRATION  -->
            <!-- ====================================== -->

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <h4 class="fw-bold mb-2">
                        Available Categories
                    </h4>

                    <p class="text-muted">
                        Select a category to participate in this event.
                    </p>

                    @if (Model.Categories == null ||
                         !Model.Categories.Any())
                    {
                        <div class="alert alert-info">
                            No categories are currently available
                            for this event.
                        </div>
                    }
                    else
                    {
                        <!-- CATEGORY TABLE -->
                        <div class="table-responsive">

                            <table class="table table-striped
                                          table-hover align-middle">

                                <thead class="table-dark">
                                    <tr>
                                        <th>Category</th>
                                        <th>Minimum Age</th>
                                        <th>Maximum Age</th>
                                        <th>Distance</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var category in Model.Categories)
                                    {
                                        <tr>

                                            <td class="fw-semibold">
                                                @category.CategoryName
                                            </td>

                                            <td>
                                                @(category.MinimumAge?.ToString()
                                                    ?? "No limit")
                                            </td>

                                            <td>
                                                @(category.MaximumAge?.ToString()
                                                    ?? "No limit")
                                            </td>

                                            <td>
                                                @category.Distance.ToString("0.##") km
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                        <!-- REGISTRATION FORM -->
                        <form asp-controller="ParticipantEvents"
                              asp-action="Enrol"
                              method="post"
                              class="mt-4">

                            @Html.AntiForgeryToken()

                            <!-- SELECTED EVENT -->
                            <input type="hidden"
                                   name="eventId"
                                   value="@Model.Event.EventId" />

                            <!-- CATEGORY SELECTION -->
                            <div class="mb-3">

                                <label for="selectedCategoryId"
                                       class="form-label fw-semibold">
                                    Race Category
                                </label>

                                <select id="selectedCategoryId"
                                        name="selectedCategoryId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        -- Select a Category --
                                    </option>

                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.CategoryId">
                                            @category.CategoryName -
                                            @category.Distance.ToString("0.##") km
                                        </option>
                                    }

                                </select>

                                <div class="form-text">
                                    Choose your preferred category
                                    before submitting your registration.
                                </div>

                            </div>

                            <!-- REGISTRATION INFORMATION -->
                            <div class="alert alert-info mt-3">

                                <strong>
                                    Registration Information
                                </strong>

                                <p class="mb-0 mt-2">
                                    You can only register once per event.
                                    Please make sure that you select
                                    the correct category.
                                </p>

                            </div>

                            <!-- SUBMIT REGISTRATION -->
                            <button type="submit"
                                    class="btn btn-primary">
                                Enrol Now
                            </button>

                        </form>
                    }

                    <!-- BACK TO EVENTS -->
                    <div class="mt-4">

                        <a asp-controller="ParticipantEvents"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Back to Browse Events
                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>

</div>
