
@model List<RaceDay.MVC.Models.EventViewModel>

@{
    ViewData["Title"] = "Browse Events";

    string search = ViewBag.Search as string ?? "";
    string eventType = ViewBag.EventType as string ?? "";
}

<div class="container mt-5 mb-5">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Browse Events
            </h2>

            <p class="text-muted mb-0">
                Find upcoming races and activities.
            </p>
        </div>

        <a asp-controller="Participant"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

    <!-- ERROR MESSAGE -->
    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- SEARCH AND FILTERS -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">

            <form asp-controller="ParticipantEvents"
                  asp-action="Index"
                  method="get">

                <div class="row g-3">

                    <div class="col-md-6">

                        <label for="search"
                               class="form-label fw-semibold">
                            Search Events
                        </label>

                        <input type="text"
                               id="search"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Search by event name or location" />

                    </div>

                    <div class="col-md-4">

                        <label for="eventType"
                               class="form-label fw-semibold">
                            Event Type
                        </label>

                        <select id="eventType"
                                name="eventType"
                                class="form-select">

                            <option value="">
                                All Event Types
                            </option>

                            <option value="run"
                                    selected="@(eventType.Equals(
                                        "run",
                                        StringComparison.OrdinalIgnoreCase))">
                                Run
                            </option>

                            <option value="walk"
                                    selected="@(eventType.Equals(
                                        "walk",
                                        StringComparison.OrdinalIgnoreCase))">
                                Walk
                            </option>

                            <option value="cycle"
                                    selected="@(eventType.Equals(
                                        "cycle",
                                        StringComparison.OrdinalIgnoreCase))">
                                Cycle
                            </option>

                        </select>

                    </div>

                    <div class="col-md-2 d-flex align-items-end">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            Search
                        </button>

                    </div>

                </div>

                <div class="mt-3">

                    <a asp-controller="ParticipantEvents"
                       asp-action="Index"
                       class="btn btn-outline-secondary btn-sm">
                        Clear Filters
                    </a>

                </div>

            </form>

        </div>
    </div>

    <!-- EVENT LISTING -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No upcoming events match your search.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm h-100 border-0
                                overflow-hidden">

                        <!-- AZURE EVENT IMAGE -->
                        @if (item.HasEventImage)
                        {
                            <a asp-controller="ParticipantEvents"
                               asp-action="Details"
                               asp-route-id="@item.EventId"
                               class="d-block">

                                <img src="@Url.Action(
                                              "Image",
                                              "ParticipantEvents",
                                              new { id = item.EventId })"
                                     alt="Image for @item.EventName"
                                     class="card-img-top"
                                     style="height: 210px;
                                            width: 100%;
                                            object-fit: cover;"
                                     loading="lazy" />

                            </a>
                        }
                        else
                        {
                            <!-- PLACEHOLDER FOR EVENTS WITHOUT IMAGES -->
                            <div class="d-flex flex-column
                                        align-items-center
                                        justify-content-center
                                        text-center bg-light"
                                 style="height: 210px;">

                                <div class="fs-1 mb-2">
                                    🏁
                                </div>

                                <p class="fw-semibold mb-1">
                                    RaceDay Event
                                </p>

                                <p class="text-muted small mb-0">
                                    No image available
                                </p>

                            </div>
                        }

                        <!-- EVENT INFORMATION -->
                        <div class="card-body d-flex flex-column">

                            <div class="mb-3">

                                <span class="badge bg-primary">
                                    @item.EventType
                                </span>

                            </div>

                            <h5 class="fw-bold">
                                @item.EventName
                            </h5>

                            <p class="text-muted">
                                @(string.IsNullOrWhiteSpace(
                                    item.Description)
                                    ? "No description available."
                                    : item.Description)
                            </p>

                            <div class="mt-auto">

                                <p class="mb-2">

                                    <strong>Date:</strong>

                                    @item.EventDate.ToString(
                                        "dd MMM yyyy")

                                </p>

                                <p class="mb-2">

                                    <strong>Time:</strong>

                                    @item.EventDate.ToString("HH:mm")

                                </p>

                                <p class="mb-2">

                                    <strong>Location:</strong>

                                    @item.Location

                                </p>

                                <p class="mb-3">

                                    <strong>Distance:</strong>

                                    @item.Distance.ToString("0.##") km

                                </p>

                                <a asp-controller="ParticipantEvents"
                                   asp-action="Details"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-primary w-100">
                                    View Details
                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>

        <p class="text-muted mt-4">
            Upcoming Events:
            <strong>@Model.Count</strong>
        </p>
    }

</div>
