@model RaceDay.MVC.Models.ParticipantProfileViewModel

@{
    ViewData["Title"] = "My Profile";

    bool hasProfilePicture = Model.HasProfilePicture;
    string initial = string.IsNullOrWhiteSpace(Model.FirstName)
        ? "?"
        : Model.FirstName[..1].ToUpperInvariant();
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <!-- PAGE HEADER -->
                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                        <div>
                            <h2 class="fw-bold mb-1">My Profile</h2>
                            <p class="text-muted mb-0">
                                View and manage your personal information.
                            </p>
                        </div>

                        <a asp-controller="OrganiserProfile"
                           asp-action="Edit"
                           class="btn btn-primary">
                            Edit Profile
                        </a>
                    </div>

                    <!-- SUCCESS MESSAGE -->
                    @if (TempData["SuccessMessage"] is string success)
                    {
                        <div class="alert alert-success alert-dismissible fade show"
                             role="alert">
                            @success
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>
                        </div>
                    }

                    <!-- ERROR MESSAGE -->
                    @if (TempData["ErrorMessage"] is string error)
                    {
                        <div class="alert alert-danger alert-dismissible fade show"
                             role="alert">
                            @error
                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>
                        </div>
                    }

                    <!-- PROFILE PICTURE SECTION -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body p-4">

                            <h5 class="fw-bold mb-3">
                                Profile Picture
                            </h5>

                            <div class="row align-items-center g-4">

                                <!-- IMAGE PREVIEW -->
                                <div class="col-md-4 text-center">
                                    @if (hasProfilePicture)
                                    {
                                        <img src="@Url.Action("Picture", "OrganiserProfile")"
                                             alt="Your profile picture"
                                             class="rounded-circle border shadow-sm"
                                             style="width:180px;height:180px;object-fit:cover;"
                                             width="180"
                                             height="180" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center mx-auto"
                                             style="width:180px;height:180px;">
                                            <span class="fw-bold" style="font-size:48px;">
                                                @initial
                                            </span>
                                        </div>
                                    }

                                    <p class="text-muted small mt-3 mb-0">
                                        @(hasProfilePicture
                                            ? "Your current profile picture"
                                            : "No profile picture uploaded")
                                    </p>
                                </div>

                                <!-- UPLOAD FORM -->
                                <div class="col-md-8">

                                    <h6 class="fw-semibold">
                                        @(hasProfilePicture
                                            ? "Change Profile Picture"
                                            : "Upload Profile Picture")
                                    </h6>

                                    <p class="text-muted small">
                                        Choose a JPG, PNG or WebP image.
                                        Maximum file size: 5 MB.
                                    </p>

                                    <form asp-controller="OrganiserProfile"
                                          asp-action="UploadPicture"
                                          method="post"
                                          enctype="multipart/form-data">

                                        @Html.AntiForgeryToken()

                                        <div class="mb-3">
                                            <label for="file" class="form-label">
                                                Select Image
                                            </label>

                                            <input type="file"
                                                   id="file"
                                                   name="file"
                                                   class="form-control"
                                                   accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                                   required />
                                        </div>

                                        <button type="submit" class="btn btn-primary">
                                            @(hasProfilePicture
                                                ? "Replace Picture"
                                                : "Upload Picture")
                                        </button>
                                    </form>

                                    <!-- DELETE FORM -->
                                    @if (hasProfilePicture)
                                    {
                                        <form asp-controller="OrganiserProfile"
                                              asp-action="DeletePicture"
                                              method="post"
                                              class="mt-3"
                                              onsubmit="return confirm('Are you sure you want to remove your profile picture?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-outline-danger">
                                                Remove Picture
                                            </button>
                                        </form>
                                    }

                                    <div class="alert alert-info mt-3 mb-0 small">
                                        Your picture is stored securely in Azure Blob Storage
                                        and accessed through RaceDay.API.
                                    </div>

                                </div>
                            </div>

                        </div>
                    </div>

                    <!-- ORGANISER NAME -->
                    <h4 class="fw-bold mb-3">
                        @Model.FirstName @Model.LastName
                    </h4>

                    <!-- PERSONAL INFORMATION -->
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">
                                    <h6 class="text-muted">First Name</h6>
                                    <h5 class="fw-bold mb-0">@Model.FirstName</h5>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">
                                    <h6 class="text-muted">Last Name</h6>
                                    <h5 class="fw-bold mb-0">@Model.LastName</h5>
                                </div>
                            </div>
                        </div>

                    </div>

                    <!-- ACCOUNT INFORMATION -->
                    <h5 class="fw-bold">
                        Account Information
                    </h5>

                    <div class="table-responsive">
                        <table class="table table-bordered mt-3">
                            <tbody>
                                <tr>
                                    <th scope="row">User ID</th>
                                    <td>@Model.UserId</td>
                                </tr>
                                <tr>
                                    <th scope="row">Email Address</th>
                                    <td>@Model.Email</td>
                                </tr>
                                <tr>
                                    <th scope="row">Phone Number</th>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                            ? "Not provided"
                                            : Model.PhoneNumber)
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">Date of Birth</th>
                                    <td>
                                        @(Model.DateOfBirth.HasValue
                                            ? Model.DateOfBirth.Value.ToString("dd MMM yyyy")
                                            : "Not provided")
                                    </td>
                                </tr>
                                <tr>
                                    <th scope="row">Member Since</th>
                                    <td>
                                        @Model.CreatedAt.ToString("dd MMM yyyy")
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="alert alert-info mt-3">
                        Your email address and account role cannot be changed from this page.
                    </div>

                    <!-- DASHBOARD NAVIGATION -->
                    <a asp-controller="Organiser"
                       asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to Dashboard
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>
