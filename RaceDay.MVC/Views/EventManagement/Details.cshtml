@model RaceDay.MVC.Models.EventViewModel

@{
    ViewData["Title"] = "Event Details";

    bool hasEventImage = Model.HasEventImage;
}

<div class="container mt-5 mb-5">

    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="card shadow border-0">

                <div class="card-body p-4">

                    <!-- PAGE HEADER -->
                    <div class="d-flex justify-content-between
                        align-items-center flex-wrap gap-3 mb-4">

                        <div>
                            <h2 class="fw-bold mb-1">
                                Event Details
                            </h2>

                            <p class="text-muted mb-0">
                                View and manage your RaceDay event.
                            </p>
                        </div>

                        <span class="badge bg-primary fs-6">
                            @Model.EventType
                        </span>

                    </div>

                    <!-- SUCCESS MESSAGE -->
                    @if (TempData["SuccessMessage"] is string success)
                    {
                        <div class="alert alert-success
                            alert-dismissible fade show"
                             role="alert">

                            @success

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>
                    }

                    <!-- ERROR MESSAGE -->
                    @if (TempData["ErrorMessage"] is string error)
                    {
                        <div class="alert alert-danger
                            alert-dismissible fade show"
                             role="alert">

                            @error

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Close">
                            </button>

                        </div>
                    }

                    <hr />

                    <!-- EVENT NAME -->
                    <h3 class="fw-bold mt-4">
                        @Model.EventName
                    </h3>

                    <!-- ====================================== -->
                    <!-- AZURE BLOB STORAGE - EVENT IMAGE        -->
                    <!-- ====================================== -->

                    <div class="card bg-light border-0 mt-4 mb-4">

                        <div class="card-body p-4">

                            <h5 class="fw-bold mb-3">
                                Event Image
                            </h5>

                            <!-- CURRENT EVENT IMAGE -->
                            @if (hasEventImage)
                            {
                                <div class="mb-4">

                                    <img src="@Url.Action(
                                                                                      "Image",
                                                                                      "EventManagement",
                                                                                      new { id = Model.EventId })"
                                         alt="Image for @Model.EventName"
                                         class="img-fluid rounded shadow-sm w-100"
                                         style="max-height: 360px;
                                    object-fit: cover;" />

                                    <p class="text-muted small mt-2 mb-0">
                                        Current event image stored in Azure Blob Storage.
                                    </p>

                                </div>
                            }
                            else
                            {
                                <div class="text-center
                                    bg-white rounded border
                                    py-5 mb-4">

                                    <div class="fs-1 mb-2">
                                        🏁
                                    </div>

                                    <h6 class="fw-semibold">
                                        No Event Image
                                    </h6>

                                    <p class="text-muted small mb-0">
                                        Upload an image to represent this race.
                                    </p>

                                </div>
                            }

                            <!-- IMAGE UPLOAD FORM -->
                            <div class="mt-3">

                                <h6 class="fw-semibold">
                                    @(hasEventImage
                                        ? "Replace Event Image"
                                        : "Upload Event Image")
                                </h6>

                                <p class="text-muted small">
                                    Choose a JPG, JPEG, PNG or WebP image.
                                    Maximum file size: 5 MB.
                                </p>

                                <form asp-controller="EventManagement"
                                      asp-action="UploadImage"
                                      asp-route-id="@Model.EventId"
                                      method="post"
                                      enctype="multipart/form-data">

                                    @Html.AntiForgeryToken()

                                    <div class="mb-3">

                                        <label for="eventImageFile"
                                               class="form-label">
                                            Select Event Image
                                        </label>

                                        <input type="file"
                                               id="eventImageFile"
                                               name="file"
                                               class="form-control"
                                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                                               required />

                                    </div>

                                    <button type="submit"
                                            class="btn btn-primary">

                                        @(hasEventImage
                                            ? "Replace Image"
                                            : "Upload Image")

                                    </button>

                                </form>

                            </div>

                            <!-- REMOVE IMAGE FORM -->
                            @if (hasEventImage)
                            {
                                <form asp-controller="EventManagement"
                                      asp-action="DeleteImage"
                                      asp-route-id="@Model.EventId"
                                      method="post"
                                      class="mt-3"
                                      onsubmit="return confirm('Are you sure you want to remove this event image?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger">
                                        Remove Image
                                    </button>

                                </form>
                            }

                            <!-- AZURE INFORMATION -->
                            <div class="alert alert-info mt-4 mb-0 small">

                                Event images are stored securely in
                                Azure Blob Storage and accessed through
                                RaceDay.API.

                            </div>

                        </div>
                    </div>

                    <!-- DESCRIPTION -->
                    <div class="mt-4">

                        <h5 class="fw-semibold">
                            Description
                        </h5>

                        <p class="text-muted">
                            @(string.IsNullOrWhiteSpace(Model.Description)
                                ? "No description provided."
                                : Model.Description)
                        </p>

                    </div>

                    <!-- EVENT INFORMATION -->
                    <div class="row g-3 mt-2">

                        <!-- EVENT DATE -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Event Date
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.EventDate.ToString("dd MMM yyyy")
                                    </h5>

                                </div>
                            </div>

                        </div>

                        <!-- START TIME -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Start Time
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.EventDate.ToString("HH:mm")
                                    </h5>

                                </div>
                            </div>

                        </div>

                        <!-- LOCATION -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Location
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.Location
                                    </h5>

                                </div>
                            </div>

                        </div>

                        <!-- DISTANCE -->
                        <div class="col-md-6">

                            <div class="card bg-light border-0 h-100">
                                <div class="card-body">

                                    <h6 class="text-muted">
                                        Distance
                                    </h6>

                                    <h5 class="fw-bold mb-0">
                                        @Model.Distance.ToString("0.##") km
                                    </h5>

                                </div>
                            </div>

                        </div>

                    </div>

                    <!-- ADDITIONAL INFORMATION -->
                    <div class="mt-4">

                        <h5 class="fw-bold">
                            Additional Information
                        </h5>

                        <div class="table-responsive">

                            <table class="table table-bordered mt-3">

                                <tbody>

                                    <tr>
                                        <th scope="row">
                                            Event ID
                                        </th>

                                        <td>
                                            @Model.EventId
                                        </td>
                                    </tr>

                                    <tr>
                                        <th scope="row">
                                            Event Type
                                        </th>

                                        <td>
                                            @Model.EventType
                                        </td>
                                    </tr>

                                    <tr>
                                        <th scope="row">
                                            Created On
                                        </th>

                                        <td>
                                            @Model.CreatedAt.ToString(
                                                "dd MMM yyyy HH:mm")
                                        </td>
                                    </tr>

                                </tbody>

                            </table>

                        </div>

                    </div>

                    <hr class="mt-4" />

                    <!-- ====================================== -->
                    <!-- EXISTING EVENT MANAGEMENT ACTIONS       -->
                    <!-- ====================================== -->

                    <div class="d-flex flex-wrap gap-2 mt-4">

                        <!-- MANAGE CATEGORIES -->
                        <a asp-controller="CategoryManagement"
                           asp-action="Index"
                           asp-route-eventId="@Model.EventId"
                           class="btn btn-primary">

                            Manage Categories

                        </a>

                        <!-- VIEW ENROLMENTS -->
                        <a asp-controller="OrganiserEnrolments"
                           asp-action="Index"
                           asp-route-eventId="@Model.EventId"
                           class="btn btn-success">

                            View Enrolments

                        </a>

                        <!-- VIEW RACE RESULTS -->
                        <a asp-controller="OrganiserResults"
                           asp-action="Index"
                           asp-route-eventId="@Model.EventId"
                           class="btn btn-dark">

                            View Race Results

                        </a>

                        <!-- EDIT EVENT -->
                        <a asp-controller="EventManagement"
                           asp-action="Edit"
                           asp-route-id="@Model.EventId"
                           class="btn btn-warning">

                            Edit Event

                        </a>

                        <!-- DELETE EVENT -->
                        <a asp-controller="EventManagement"
                           asp-action="Delete"
                           asp-route-id="@Model.EventId"
                           class="btn btn-danger">

                            Delete Event

                        </a>

                        <!-- BACK TO EVENTS -->
                        <a asp-controller="EventManagement"
                           asp-action="Index"
                           class="btn btn-outline-secondary">

                            Back to My Events

                        </a>

                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
