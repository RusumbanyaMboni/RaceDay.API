@model RaceDay.MVC.Models.RecordResultViewModel

@{
    ViewData["Title"] = "Record Race Result";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-2">
                        Record Race Result
                    </h2>

                    <p class="text-muted mb-4">
                        Record a participant's finishing time and position.
                    </p>

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <!-- Participant Information -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">

                            <h5 class="fw-bold">
                                @Model.EventName
                            </h5>

                            <p class="mb-2">
                                <strong>Participant ID:</strong>
                                @Model.ParticipantId
                            </p>

                            <p class="mb-2">
                                <strong>Category:</strong>
                                @Model.CategoryName
                            </p>

                            <p class="mb-0">
                                <strong>Enrolment ID:</strong>
                                @Model.EnrolmentId
                            </p>

                        </div>
                    </div>

                    <!-- Result Form -->
                    <form asp-controller="OrganiserResults"
                          asp-action="Record"
                          asp-route-enrolmentId="@Model.EnrolmentId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Finish Time -->
                        <div class="mb-3">

                            <label asp-for="FinishTime"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="FinishTime"
                                   type="text"
                                   class="form-control"
                                   placeholder="01:25:30"
                                   pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}"
                                   required />

                            <span asp-validation-for="FinishTime"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Enter hours, minutes and seconds,
                                for example 01:25:30.
                            </div>

                        </div>

                        <!-- Finish Position -->
                        <div class="mb-3">

                            <label asp-for="FinishPosition"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="FinishPosition"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="FinishPosition"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-info">
                            Saving this result will automatically change
                            the participant's enrolment status to
                            <strong>Completed</strong>.
                        </div>

                        <div class="d-flex gap-2 flex-wrap mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Race Result
                            </button>

                            <a asp-controller="OrganiserEnrolments"
                               asp-action="Index"
                               asp-route-eventId="@Model.EventId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
