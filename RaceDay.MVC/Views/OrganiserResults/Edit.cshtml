@model RaceDay.MVC.Models.EditResultViewModel

@{
    ViewData["Title"] = "Edit Race Result";
}

<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow border-0">
                <div class="card-body p-4">

                    <h2 class="fw-bold mb-2">
                        Edit Race Result
                    </h2>

                    <p class="text-muted mb-4">
                        Update a participant's finishing time
                        and position.
                    </p>

                    <!-- Validation -->
                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <!-- Result Information -->
                    <div class="card bg-light border-0 mb-4">
                        <div class="card-body">

                            <h5 class="fw-bold">
                                @Model.EventName
                            </h5>

                            <p class="mb-2">
                                <strong>Participant:</strong>
                                @Model.ParticipantName
                            </p>

                            <p class="mb-2">
                                <strong>Category:</strong>
                                @Model.CategoryName
                            </p>

                            <p class="mb-0">
                                <strong>Result ID:</strong>
                                @Model.ResultId
                            </p>

                        </div>
                    </div>

                    <!-- Edit Form -->
                    <form asp-controller="OrganiserResults"
                          asp-action="Edit"
                          asp-route-id="@Model.ResultId"
                          method="post">

                        @Html.AntiForgeryToken()

                        <!-- Finish Time -->
                        <div class="mb-3">

                            <label asp-for="FinishTime"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="FinishTime"
                                   type="text"
                                   class="form-control"
                                   placeholder="01:25:30"
                                   pattern="[0-9]{2}:[0-9]{2}:[0-9]{2}"
                                   required />

                            <span asp-validation-for="FinishTime"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Use HH:MM:SS, for example 01:20:15.
                            </div>

                        </div>

                        <!-- Finish Position -->
                        <div class="mb-3">

                            <label asp-for="FinishPosition"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="FinishPosition"
                                   type="number"
                                   min="1"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="FinishPosition"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-info">
                            Saving changes will update the existing
                            result without creating a new one.
                        </div>

                        <!-- Actions -->
                        <div class="d-flex flex-wrap gap-2 mt-4">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Changes
                            </button>

                            <a asp-controller="OrganiserResults"
                               asp-action="Index"
                               asp-route-eventId="@Model.EventId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
