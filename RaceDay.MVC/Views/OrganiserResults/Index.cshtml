
@model List<RaceDay.MVC.Models.ResultViewModel>

@{
    ViewData["Title"] = "Race Results";

    int eventId = ViewBag.EventId != null
        ? Convert.ToInt32(ViewBag.EventId)
        : 0;

    string eventName = ViewBag.EventName as string
        ?? "Selected Event";
}

<div class="container mt-5 mb-5">

    <!-- Page Header -->
    <div class="d-flex justify-content-between
                align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Race Results
            </h2>

            <p class="text-muted mb-0">
                Results for <strong>@eventName</strong>.
            </p>
        </div>

        <div class="d-flex gap-2 flex-wrap">

            <a asp-controller="OrganiserEnrolments"
               asp-action="Index"
               asp-route-eventId="@eventId"
               class="btn btn-primary">
                View Enrolments
            </a>

            <a asp-controller="EventManagement"
               asp-action="Details"
               asp-route-id="@eventId"
               class="btn btn-outline-secondary">
                Back to Event Details
            </a>

        </div>

    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <!-- Results -->
    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No race results have been recorded for this event yet.

            To record a result, open
            <strong>View Enrolments</strong> and select
            <strong>Record Result</strong> for a participant.
        </div>
    }
    else
    {
        <!-- Statistics -->
        <div class="row g-3 mb-4">

            <!-- Total Results -->
            <div class="col-md-6">

                <div class="card bg-light border-0 h-100">
                    <div class="card-body">

                        <h6 class="text-muted">
                            Total Results
                        </h6>

                        <h3 class="fw-bold mb-0">
                            @Model.Count
                        </h3>

                    </div>
                </div>

            </div>

            <!-- Best Finish Time -->
            <div class="col-md-6">

                <div class="card bg-light border-0 h-100">
                    <div class="card-body">

                        <h6 class="text-muted">
                            Best Finish Time
                        </h6>

                        <h3 class="fw-bold mb-0">

                            @(Model.Min(r => r.FinishTime).ToString(@"hh\:mm\:ss"))

                        </h3>

                    </div>
                </div>

            </div>

        </div>

        <!-- Results Table -->
        <div class="table-responsive">

            <table class="table table-striped table-hover align-middle">

                <thead class="table-dark">

                    <tr>
                        <th scope="col">Position</th>
                        <th scope="col">Participant</th>
                        <th scope="col">Category</th>
                        <th scope="col">Finish Time</th>
                        <th scope="col">Recorded At</th>
                        <th scope="col">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var result in Model)
                    {
                        <tr>

                            <!-- Position -->
                            <td class="fw-bold">
                                @result.FinishPosition
                            </td>

                            <!-- Participant -->
                            <td>
                                @(string.IsNullOrWhiteSpace(
                                    result.ParticipantName)
                                    ? $"Participant #{result.ParticipantId}"
                                    : result.ParticipantName)
                            </td>

                            <!-- Category -->
                            <td>
                                @(string.IsNullOrWhiteSpace(
                                    result.CategoryName)
                                    ? "Unknown Category"
                                    : result.CategoryName)
                            </td>

                            <!-- Finish Time -->
                            <td class="fw-semibold">
                                @result.FinishTime.ToString(@"hh\:mm\:ss")
                            </td>

                            <!-- Recorded At -->
                            <td>
                                @result.RecordedAt.ToString(
                                    "dd MMM yyyy HH:mm")
                            </td>

                            <!-- Actions -->
                            <td>

                                <div class="d-flex gap-2 flex-wrap">

                                    <!-- Edit Result -->
                                    <a asp-controller="OrganiserResults"
                                       asp-action="Edit"
                                       asp-route-id="@result.ResultId"
                                       class="btn btn-warning btn-sm">
                                        Edit
                                    </a>

                                    <!-- Delete Result -->
                                    <a asp-controller="OrganiserResults"
                                       asp-action="Delete"
                                       asp-route-id="@result.ResultId"
                                       class="btn btn-danger btn-sm">
                                        Delete
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <p class="text-muted mt-3">
            Total Results:
            <strong>@Model.Count</strong>
        </p>
    }

    <!-- Navigation -->
    <div class="mt-4">

        <a asp-controller="Organiser"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Dashboard
        </a>

    </div>

</div>
